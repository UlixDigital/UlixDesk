generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A company or contact UlixDesk will track time for.
model Client {
  id         String        @id @default(cuid())
  name       String
  address    String?
  phone      String?
  emails     ClientEmail[]
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  projects   Project[]

  @@index([archivedAt])
  @@index([name])
}

/// Related rows because SQLite does not support Prisma scalar lists.
model ClientEmail {
  id       String @id @default(cuid())
  email    String
  position Int    @default(0)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId])
}

/// Work tracked for an optional client. Archive sets archivedAt; rows are not deleted.
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  billable    Boolean   @default(true)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  timeEntries TimeEntry[]

  @@index([clientId])
  @@index([archivedAt])
  @@index([name])
}

/// One block of tracked time. `endedAt` is null only while its timer is running.
/// `userId` stays null until authentication exists. Every current row belongs to
/// the single workspace. Adding accounts later means filling `userId` and using
/// that id as `RunningTimer.id` — the time columns do not need to change.
model TimeEntry {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId       String?
  startedAt    DateTime
  endedAt      DateTime?
  billable     Boolean
  note         String?
  source       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  runningTimer RunningTimer?

  @@index([projectId])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([endedAt])
}

/// At most one running timer. The id is "workspace" until each user has an account.
model RunningTimer {
  id          String    @id
  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
}

/// A bearer token for the Chrome extension. Only the hash is stored.
/// The plaintext is shown once, when the token is created.
model AccessToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([createdAt])
}
