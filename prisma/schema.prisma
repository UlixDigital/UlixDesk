generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A staff account. There is no public signup and no client login.
/// `role` is owner, admin, or member.
model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  role           String          @default("member")
  passwordHash   String?
  deactivatedAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions          Session[]
  passwordSetups    PasswordSetup[]
  accessTokens      AccessToken[]
  extensionSessions ExtensionSession[]
  timeEntries       TimeEntry[]
  timeChangesMade   TimeChange[] @relation("TimeChangeActor")
  timeChangesOwned  TimeChange[] @relation("TimeChangeSubject")
  memberBillRates   BillRate[] @relation("MemberBillRate")
  billRatesCreated  BillRate[] @relation("BillRateAuthor")
  savedReports      SavedReport[]
  budgetsCreated    Budget[]
  invoicesCreated   Invoice[]        @relation("InvoiceAuthor")
  invoicePayments   InvoicePayment[]
  invoiceStatusEvents InvoiceStatusEvent[]
  invoiceEmailsSent InvoiceEmail[]

  @@index([role])
  @@index([deactivatedAt])
}

/// Server-side session. The cookie holds a random token; only the hash is stored.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  rotatedAt  DateTime @default(now())
  expiresAt  DateTime
  /// Token hash replaced by the latest rotation. Accepted until
  /// `previousTokenExpiresAt` so a second in-flight refresh is not a sign-out.
  previousTokenHash      String?   @unique
  previousTokenExpiresAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// One-time set-password token. The plaintext is shown once. Only the hash is stored.
model PasswordSetup {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A company or contact UlixDesk tracks time for.
model Client {
  id         String        @id @default(cuid())
  name       String
  address    String?
  phone      String?
  emails     ClientEmail[]
  /// ISO 4217 code. New clients copy the workspace default. Existing rows start as USD.
  currency       String        @default("USD")
  /// Printed in the To block. When blank, invoices use `address`.
  billingAddress String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  projects       Project[]
  billRates      BillRate[]
  invoices       Invoice[]
  budget     Budget?

  @@index([archivedAt])
  @@index([name])
}

/// Billing email for a client, in the order shown on the form.
/// These addresses prefill the To field when an invoice is emailed.
model ClientEmail {
  id       String @id @default(cuid())
  email    String
  position Int    @default(0)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId])
}

/// Work tracked for an optional client. Archive sets archivedAt; rows are not deleted.
model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  billable    Boolean     @default(true)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries TimeEntry[]
  billRates   BillRate[]
  budget      Budget?

  @@index([clientId])
  @@index([archivedAt])
  @@index([name])
}

/// One workspace row. New clients inherit `defaultCurrency`.
/// `timeZone` is an IANA name. Timesheet days and rate effective dates use 00:00 in that zone.
/// Invoice bank details default to placeholders. Real account numbers are not stored in git.
model WorkspaceSettings {
  id                  String   @id @default("workspace")
  defaultCurrency     String   @default("USD")
  timeZone            String   @default("Asia/Colombo")
  companyName         String   @default("Ulix Digital")
  companyAddress      String   @default("30 North Gould Street, Sheridan, WY 82801")
  invoicePrefix       String   @default("LE")
  nextInvoiceNumber   Int      @default(1176)
  invoiceNetTermsDays Int      @default(7)
  invoiceNotes        String   @default("* All payments are non refundable\n* Use these details to send both Domestic wires and ACH transfers to Ulix Digital")
  invoiceBankDetails  String   @default("Beneficiary Name: Ulix Digital\nAddress: 30 North Gould Street, Sheridan, WY 82801\n\nAccount Number: [not set]\nABA Routing Number: [not set]\nType of Account: Checking\nBank Name: [not set]")
  invoiceTaxEnabled   Boolean  @default(false)
  invoiceTaxLabel     String   @default("Tax")
  invoiceTaxRateBps   Int      @default(0)
  updatedAt           DateTime @updatedAt
}

/// Hourly bill rate history. Money is integer minor units, never a float.
/// `scope` is client, project, or member. `effectiveFrom` is a calendar date.
/// The rate starts at 00:00 in the workspace timezone on that date.
model BillRate {
  id            String    @id @default(cuid())
  scope         String
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?     @relation("MemberBillRate", fields: [userId], references: [id], onDelete: Cascade)
  amountMinor   Int
  currency      String
  effectiveFrom DateTime  @db.Date
  createdById   String
  createdBy     User      @relation("BillRateAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([clientId, effectiveFrom])
  @@index([projectId, effectiveFrom])
  @@index([userId, clientId, effectiveFrom])
}

/// One block of tracked time. `endedAt` is null only while its timer is running.
/// `userId` is the staff member who tracked it. Rows from before accounts existed
/// stay null until bootstrap assigns them to the owner.
model TimeEntry {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  startedAt    DateTime
  endedAt      DateTime?
  billable     Boolean
  note         String?
  source       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  runningTimer RunningTimer?
  invoiceTimes InvoiceTime[]

  @@index([projectId])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([endedAt])
}

/// Append-only log of a time entry create, edit, delete, or timer start/stop.
/// `timeEntryId` is not a foreign key, so deleting the entry keeps the row.
/// The database rejects UPDATE and DELETE. Nothing in the app writes those.
/// Existing entries from before this table have no rows here.
model TimeChange {
  id          String   @id @default(cuid())
  timeEntryId String
  /// added, edited, deleted, started, or stopped.
  action      String
  /// web, extension, or api.
  source      String
  actorId     String
  actor       User     @relation("TimeChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  /// The person whose time entry changed. Members are limited to their own id.
  entryUserId String?
  entryUser   User?    @relation("TimeChangeSubject", fields: [entryUserId], references: [id], onDelete: Restrict)
  changedAt   DateTime @default(now())

  beforeStartedAt  DateTime?
  beforeEndedAt    DateTime?
  beforeDurationMs Int?
  beforeProjectId  String?
  beforeClientId   String?
  beforeNote       String?
  beforeBillable   Boolean?

  afterStartedAt  DateTime?
  afterEndedAt    DateTime?
  afterDurationMs Int?
  afterProjectId  String?
  afterClientId   String?
  afterNote       String?
  afterBillable   Boolean?

  @@index([changedAt])
  @@index([entryUserId, changedAt])
  @@index([timeEntryId])
  @@index([actorId])
}

/// One running timer per user. `id` is that user's id.
/// The legacy id "workspace" is reassigned to the bootstrap owner.
model RunningTimer {
  id          String    @id
  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
}

/// One budget for a project or a client. Hours are whole seconds. Cost is minor
/// units of `currency`. A project and a client each have at most one row.
model Budget {
  id           String    @id @default(cuid())
  /// project or client.
  scope        String
  projectId    String?   @unique
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String?   @unique
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// hours or cost.
  basis        String
  /// Hours: seconds. Cost: minor units of `currency`.
  amount       Int
  /// Set for a cost budget. Null for hours.
  currency     String?
  /// total, weekly, or monthly. Weekly and monthly reset in the workspace timezone.
  recurrence   String
  /// Optional calendar date. Time before 00:00 that day is ignored.
  startsOn     DateTime? @db.Date
  billableOnly Boolean   @default(true)
  /// 1–99. Null means no in-app warning.
  alertPercent Int?
  /// Project budgets only. At 100%, block new timer starts and manual entries.
  hardStop     Boolean   @default(false)
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scope])
}

/// A named set of report filters, grouping, and columns.
/// `visibility` is private or shared. Only owners and admins can share.
/// `params` is re-parsed with the report query parser whenever it is opened.
model SavedReport {
  id          String   @id @default(cuid())
  name        String
  reportType  String
  visibility  String   @default("private")
  params      Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Exact uniqueness for Prisma. Case-insensitive uniqueness is
  /// SavedReport_createdById_lower_name_key (lower(name)).
  @@unique([createdById, name])
  @@index([visibility])
}

/// A bearer token for the Chrome extension. It belongs to the user who created it.
/// Only the hash is stored. The plaintext is shown once, when the token is created.
model AccessToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([createdAt])
}

/// A Chrome extension sign-in. The access token is short-lived. The refresh
/// token rotates. Only hashes are stored. The plaintext is never written.
model ExtensionSession {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String
  accessTokenHash     String    @unique
  refreshTokenHash    String    @unique
  previousRefreshHash String?   @unique
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?
  accessExpiresAt     DateTime
  refreshExpiresAt    DateTime
  rotatedAt           DateTime  @default(now())
  revokedAt           DateTime?

  @@index([userId])
  @@index([createdAt])
}

/// A number taken from the invoice counter. Rows stay after the invoice is deleted,
/// so a number is never issued twice. A rolled-back allocation does not insert a row.
model InvoiceNumber {
  number      String   @id
  allocatedAt DateTime @default(now())
}

/// A client invoice. `number` is allocated from WorkspaceSettings and never reused.
/// `status` is draft, open, paid, partially_paid, or void.
/// Money is integer minor units in `currency` (the client's currency at creation).
model Invoice {
  id                  String    @id @default(cuid())
  number              String    @unique
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status              String
  currency            String
  issueDate           DateTime  @db.Date
  dueDate             DateTime  @db.Date
  poNumber            String?
  periodStart         DateTime  @db.Date
  periodEnd           DateTime  @db.Date
  /// period, project, member, or day.
  grouping            String
  notes               String
  bankDetails         String
  /// none, amount, or percent. Percent is basis points (10% = 1000).
  discountKind        String    @default("none")
  discountBps         Int       @default(0)
  discountAmountMinor Int       @default(0)
  taxEnabled          Boolean   @default(false)
  taxLabel            String    @default("Tax")
  taxRateBps          Int       @default(0)
  subtotalMinor       Int
  discountMinor       Int
  taxMinor            Int
  totalMinor          Int
  paidMinor           Int       @default(0)
  createdById         String
  createdBy           User      @relation("InvoiceAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  issuedAt            DateTime?
  voidedAt            DateTime?
  /// SHA-256 of the client view token. The plaintext is not stored.
  /// A sealed copy (AES-256-GCM under INVOICE_LINK_KEY) lets owners and admins
  /// copy the same link again. Both are cleared when the link is revoked.
  viewTokenHash       String?   @unique
  viewTokenCipher     String?
  viewTokenNonce      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lines               InvoiceLine[]
  payments            InvoicePayment[]
  timeLinks           InvoiceTime[]
  statusEvents        InvoiceStatusEvent[]
  emailsSent          InvoiceEmail[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
}

/// One invoice row. `quantitySeconds` is the billed duration, shown as H:MM:SS.
/// `amountMinor` is billAmountMinor(unitPriceMinor, quantitySeconds * 1000).
model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int
  /// time or custom.
  kind            String
  title           String
  detail          String   @default("")
  quantitySeconds Int
  unitPriceMinor  Int
  amountMinor     Int
  timeLinks       InvoiceTime[]

  @@index([invoiceId])
}

/// One billed window of a time entry. Two invoices may bill different parts of
/// the same entry. InvoiceTime_no_overlap rejects overlapping windows.
/// Drafts do not lock the entry. Any issued window locks the whole entry,
/// via time_entry_invoice_lock.
model InvoiceTime {
  id            String      @id @default(cuid())
  timeEntryId   String
  timeEntry     TimeEntry   @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceLineId String
  line          InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  /// Inclusive start of the billed window.
  sliceStart    DateTime
  /// Exclusive end of the billed window.
  sliceEnd      DateTime
  /// Voided invoices set this false so the overlap constraint releases the window.
  /// Reopening sets it true again, and InvoiceTime_no_overlap rejects a clash.
  active        Boolean   @default(true)

  @@index([timeEntryId])
  @@index([invoiceId])
  @@index([invoiceLineId])
}

/// A payment recorded against an invoice. Recording payments is a later slice.
model InvoicePayment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinor  Int
  paidOn       DateTime @db.Date
  method       String?
  note         String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

/// One status change. Issue, void, and reopen each write a row.
model InvoiceStatusEvent {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus String
  toStatus   String
  reason     String
  createdAt  DateTime @default(now())

  @@index([invoiceId, createdAt])
}

/// One attempt to email an invoice. Failures are kept as well as successes.
model InvoiceEmail {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentById     String
  sentBy       User     @relation(fields: [sentById], references: [id], onDelete: Restrict)
  toAddresses  String[]
  ccAddresses  String[]
  subject      String
  success      Boolean
  error        String?
  createdAt    DateTime @default(now())

  @@index([invoiceId, createdAt])
}
