# Local `npm run dev`. Copy to .env. These values match docker-compose.yml.
# They are not production secrets. Staging and production use env/*.env on the server.

# Dev database, published only on 127.0.0.1 by `npm run db:up`.
DATABASE_URL="postgresql://ulixdesk:ulixdesk@127.0.0.1:5432/ulixdesk?connection_limit=5"

# Signs the session cookie. At least 32 characters.
# The local default below is refused when ULIXDESK_APP_HOSTS contains ulixdigital.com.
ULIXDESK_SESSION_SECRET="local-dev-session-secret-not-for-production-00"

# Extra hostnames that count as this app, besides loopback. Empty for local dev.
ULIXDESK_APP_HOSTS=""

# Unpacked extension id, fixed by the key in extension/manifest.json.
ULIXDESK_EXTENSION_IDS="cjlaoflbipaehclleojofopapalhiooe"

# Extra origins that may call the timer without a bearer token. Usually empty.
ULIXDESK_TIMER_ORIGINS=""

# development, staging, or production. Only "staging" shows the rehearsal banner.
ULIXDESK_ENVIRONMENT=development

# Leave unset on a laptop. The app then ignores X-Forwarded-* and rate-limits as 127.0.0.1.
# Behind Caddy, set the secret for this one app. Staging and production use different values.
# ULIXDESK_TRUSTED_PROXY_SECRET=

# Used by `npm run user:bootstrap` only when the database has no users yet.
ULIXDESK_BOOTSTRAP_EMAIL="owner@ulix.local"
ULIXDESK_BOOTSTRAP_PASSWORD="local-owner-password"
ULIXDESK_BOOTSTRAP_NAME="Local Owner"
