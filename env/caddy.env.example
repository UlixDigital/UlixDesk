# Copy to /opt/ulixdesk/env/caddy.env on the server. Do not commit the copy.
# Caddy is the only process that should present this secret to the apps.
# Use the same value in env/staging.env and env/production.env.

ACME_EMAIL=ops@ulixdigital.com
ULIXDESK_TRUSTED_PROXY_SECRET=replace-with-at-least-16-characters
