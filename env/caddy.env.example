# Copy to /opt/ulixdesk/env/caddy.env on the server. Do not commit the copy.
# Caddy is the only process that should present these secrets to the apps.
# Staging and production use different secrets. Each app's
# ULIXDESK_TRUSTED_PROXY_SECRET must match the value Caddy sends to that site.

ACME_EMAIL=ops@ulixdigital.com
ULIXDESK_STAGING_PROXY_SECRET=replace-with-staging-proxy-secret
ULIXDESK_PRODUCTION_PROXY_SECRET=replace-with-production-proxy-secret
