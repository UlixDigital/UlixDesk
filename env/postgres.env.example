# Copy to /opt/ulixdesk/env/postgres.env on the server. Do not commit the copy.
# One Postgres cluster. Two databases, two roles. Passwords are letters and numbers only.

POSTGRES_USER=ulixdesk
POSTGRES_PASSWORD=replace-with-letters-and-numbers
POSTGRES_DB=postgres
# Owner roles. Migrations use these. They own the databases.
STAGING_DB_PASSWORD=replace-staging-db-password
PRODUCTION_DB_PASSWORD=replace-production-db-password
# App roles. The Next.js process uses these. Letters and numbers only.
# A new Postgres volume creates the roles from these values.
# An existing volume ignores this file's init script. See docs/DEPLOY.md.
STAGING_APP_DB_PASSWORD=replace-staging-app-db-password
PRODUCTION_APP_DB_PASSWORD=replace-production-app-db-password
