# Copy to /opt/ulixdesk/env/postgres.env on the server. Do not commit the copy.
# One Postgres cluster. Two databases, two roles. Passwords are letters and numbers only.

POSTGRES_USER=ulixdesk
POSTGRES_PASSWORD=replace-with-letters-and-numbers
POSTGRES_DB=postgres
STAGING_DB_PASSWORD=replace-staging-db-password
PRODUCTION_DB_PASSWORD=replace-production-db-password
