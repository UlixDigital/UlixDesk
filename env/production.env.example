# Copy to /opt/ulixdesk/env/production.env on the server. Do not commit the copy.
# desk.ulixdigital.com
# Leave PRISMA_QUERY_ENGINE_LIBRARY unset. Compose sets the generated-client
# path, and that value overrides this file. The copy under @prisma/engines
# is not in the image.

NODE_ENV=production
# Owner role. Used only to migrate and bootstrap. Not the running app.
MIGRATE_DATABASE_URL=postgresql://ulixdesk_production:replace-production-db-password@postgres:5432/ulixdesk_production?connection_limit=1
# App role. Cannot own or truncate the time edit log.
DATABASE_URL=postgresql://ulixdesk_production_app:replace-production-app-db-password@postgres:5432/ulixdesk_production?connection_limit=5
# At least 32 characters. Must differ from staging. The local default is refused on this host.
ULIXDESK_SESSION_SECRET=replace-with-another-random-string-at-least-32-chars
ULIXDESK_APP_HOSTS=desk.ulixdigital.com
ULIXDESK_EXTENSION_IDS=cjlaoflbipaehclleojofopapalhiooe
ULIXDESK_TIMER_ORIGINS=
ULIXDESK_PUBLIC_ORIGIN=https://desk.ulixdigital.com
ULIXDESK_ENVIRONMENT=production
# Must match ULIXDESK_PRODUCTION_PROXY_SECRET in env/caddy.env. Must differ from staging.
ULIXDESK_TRUSTED_PROXY_SECRET=replace-with-production-proxy-secret
ULIXDESK_BOOTSTRAP_EMAIL=owner@ulixdigital.com
ULIXDESK_BOOTSTRAP_PASSWORD=replace-with-at-least-10-characters
ULIXDESK_BOOTSTRAP_NAME=Owner
ULIXDESK_MIGRATE_LOCK=8675310
# Invoice email. Blank disables sending. See docs/INVOICES.md.
# Google Workspace: smtp.gmail.com, 587, STARTTLS, an app password.
INVOICE_SMTP_HOST=
INVOICE_SMTP_PORT=
INVOICE_SMTP_USER=
INVOICE_SMTP_PASS=
INVOICE_SMTP_FROM=
INVOICE_SMTP_FROM_NAME=
