# Copy to /opt/ulixdesk/env/staging.env on the server. Do not commit the copy.
# staging.desk.ulixdigital.com

NODE_ENV=production
DATABASE_URL=postgresql://ulixdesk_staging:replace-staging-db-password@postgres:5432/ulixdesk_staging?connection_limit=5
# At least 32 characters. Do not reuse the local development secret.
ULIXDESK_SESSION_SECRET=replace-with-a-different-random-string-at-least-32
ULIXDESK_APP_HOSTS=staging.desk.ulixdigital.com
ULIXDESK_EXTENSION_IDS=cjlaoflbipaehclleojofopapalhiooe
ULIXDESK_TIMER_ORIGINS=
ULIXDESK_PUBLIC_ORIGIN=https://staging.desk.ulixdigital.com
# Shows the staging banner. Production uses "production" and does not show it.
ULIXDESK_ENVIRONMENT=staging
# Must match ULIXDESK_STAGING_PROXY_SECRET in env/caddy.env. Must differ from production.
ULIXDESK_TRUSTED_PROXY_SECRET=replace-with-staging-proxy-secret
# First boot only, and only if this database has no users yet.
ULIXDESK_BOOTSTRAP_EMAIL=staging-owner@ulixdigital.com
ULIXDESK_BOOTSTRAP_PASSWORD=replace-with-at-least-10-characters
ULIXDESK_BOOTSTRAP_NAME=Staging Owner
# Different from production so the two apps can migrate at the same time.
ULIXDESK_MIGRATE_LOCK=8675309
