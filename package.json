{
  "name": "ulixdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:extension": "node extension/build.mjs",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate deploy",
    "user:bootstrap": "node scripts/bootstrap-owner.mjs",
    "import:sqlite": "node scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "next": "15.5.27",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "happy-dom": "^20.14.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.29",
    "deepmerge-ts": "8.0.2"
  }
}
