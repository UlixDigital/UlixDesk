# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env overrides. The committed .env is local docker Postgres only.
.env*.local
/env/*.env
!/env/*.env.example

# sqlite databases left over from earlier slices
*.db
*.db-journal
*.db-wal
*.db-shm

# unpacked Chrome extension build
/extension/dist/
/extension/ulixdesk-extension.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
