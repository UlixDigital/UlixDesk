{
	local_certs
	servers {
		protocols h1 h2 h3
	}
}

https://desk.localhost {
	tls internal
	log {
		output stdout
		format json
	}
	reverse_proxy app-production:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Ulixdesk-Proxy {$ULIXDESK_PRODUCTION_PROXY_SECRET}
	}
}

https://staging.desk.localhost {
	tls internal
	log {
		output stdout
		format json
	}
	reverse_proxy app-staging:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Ulixdesk-Proxy {$ULIXDESK_STAGING_PROXY_SECRET}
	}
}
