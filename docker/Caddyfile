{
	email {$ACME_EMAIL:ops@ulixdigital.com}
	servers {
		protocols h1 h2 h3
	}
}

desk.ulixdigital.com {
	log {
		output stdout
		format json
	}
	reverse_proxy app-production:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Ulixdesk-Proxy {$ULIXDESK_PRODUCTION_PROXY_SECRET}
	}
}

staging.desk.ulixdigital.com {
	log {
		output stdout
		format json
	}
	reverse_proxy app-staging:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Ulixdesk-Proxy {$ULIXDESK_STAGING_PROXY_SECRET}
	}
}
